# Copy to .env for local development. NEVER commit .env or put secrets in git.
# docs/03-TECH-STACK.md — Environment variables.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DATABASE_URL=postgres://rollcall:rollcall@localhost:5432/rollcall

# Seed source (private — forks plug their own parquet source here)
PARQUET_SOURCE_URL=

# IGDB fallback fetch (post-POC automation)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# S3-compatible object storage (avatars only in POC)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Transactional email (Brevo)
EMAIL_API_KEY=
DEFAULT_FROM_EMAIL=

# Error tracking
SENTRY_DSN=
