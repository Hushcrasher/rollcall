# Copy to .env for local development. NEVER commit .env or put secrets in git.
# docs/03-TECH-STACK.md — Environment variables.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DATABASE_URL=postgres://rollcall:rollcall@localhost:5432/rollcall

# Seed source (private — forks plug their own parquet source here).
# See games/seed/schema.py for the expected parquet column contract.
PARQUET_SOURCE_URL=
SEED_ALERT_EMAIL=            # optional: emailed if a scheduled seed run fails

# IGDB fallback fetch (post-POC automation)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# S3-compatible object storage — Cloudflare R2 for avatars (also used by the
# seed when PARQUET_SOURCE_URL is an s3:// URL). R2 endpoint looks like
# https://<accountid>.r2.cloudflarestorage.com ; region is "auto".
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto

# Transactional email — Brevo SMTP relay (prod). In dev, emails print to the
# console and none of these are needed.
DEFAULT_FROM_EMAIL=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=            # Brevo SMTP login
EMAIL_HOST_PASSWORD=        # Brevo SMTP key

# Anti-scraping rate limits (optional; per IP)
PROFILE_RATELIMIT=120/m
SEARCH_RATELIMIT=60/m

# Error tracking
SENTRY_DSN=
